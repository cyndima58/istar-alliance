rules_version = '2';
// iSTAR Alliance — Firestore 安全規則
// 貼到 Firebase Console → Firestore Database → 規則，按「發布」。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()       { return request.auth != null; }
    function me()             { return request.auth.uid; }
    function myUser()         { return get(/databases/$(database)/documents/users/$(me())).data; }
    // 一個帳號可以有多個身分（roles 陣列），舊帳號只有 role 欄位也相容
    function hasRole(r)       { let u = myUser(); return u.role == r || (('roles' in u) && r in u.roles); }
    function isAdmin()        { return signedIn() && hasRole('admin'); }
    function isCoach()        { return signedIn() && hasRole('coach'); }
    function isCoachOrAdmin() { return isAdmin() || isCoach(); }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── 成員 ──
    match /users/{uid} {
      allow read:  if signedIn() && (me() == uid || isCoachOrAdmin());
      allow write: if isAdmin();
    }

    // ── 課程模組 ──
    match /modules/{moduleId} {
      allow read:   if signedIn();
      allow create: if isCoach() && request.resource.data.coachId == me();
      allow update, delete: if isAdmin() || (isCoach() && resource.data.coachId == me());

      function moduleOwner() { return get(/databases/$(database)/documents/modules/$(moduleId)).data.coachId == me(); }

      // 學習資料：任何登入者可新增；模組教練、管理員、上傳者本人可改名／排序／刪除
      match /resources/{resourceId} {
        allow read:   if signedIn();
        allow create: if signedIn() && request.resource.data.addedByUid == me();
        allow update, delete: if isAdmin() || moduleOwner()
                              || resource.data.get('addedByUid', '') == me()
                              || resource.data.get('addedBy', '') == myUser().name;

        // 檔案內容（切塊存放）
        match /chunks/{chunkId} {
          allow read:   if signedIn();
          allow create: if signedIn() && request.resource.data.addedByUid == me();
          allow delete: if isAdmin() || moduleOwner() || resource.data.addedByUid == me();
        }
      }
    }

    // ── 課程分配（學員要能讀自己的，才看得到「我的課程模組」）──
    match /assignments/{studentUid} {
      allow read:  if signedIn() && (me() == studentUid || isCoachOrAdmin());
      allow write: if isCoachOrAdmin();
    }

    // ── 上課記錄（學員只能讀「學員可見」的自己的記錄；私密備註另存在 recordNotes）──
    match /records/{recordId} {
      allow read:   if isCoachOrAdmin()
                    || (signedIn() && resource.data.studentUid == me() && resource.data.visibleStudent == true);
      // 私密備註「絕對」不能寫進學員讀得到的 records，只能放在 recordNotes
      allow create: if isCoachOrAdmin() && !('privateNote' in request.resource.data);
      allow update: if (isAdmin() || (isCoach() && resource.data.coachId == me()))
                    && !('privateNote' in request.resource.data);
      allow delete: if isAdmin() || (isCoach() && resource.data.coachId == me());
    }

    // ── 教練私密備註（學員完全無法讀取）──
    match /recordNotes/{recordId} {
      allow read: if isCoachOrAdmin();
      allow create, update: if isAdmin() || (isCoach() && request.resource.data.coachId == me());
      // resource == null：刪除不存在的備註（例如記錄本來就沒寫備註）也允許，避免整批操作失敗
      allow delete: if isAdmin() || (isCoach() && (resource == null || resource.data.coachId == me()));
    }

    // ── 排課行事曆 ──
    // status: open 可預約 | pending 待確認 | confirmed 已排定 | reschedule 請求改期
    // 出席：簽到 checkIn／簽退 checkOut 一旦寫入就不能被教練或學員修改；
    // 寫入時間必須是伺服器時間（== request.time），簽名者必須是本人
    function stampOk(f) {
      let before = resource.data.get(f, null);
      let after  = request.resource.data.get(f, null);
      return after == before
          || (before == null && after != null && after.at == request.time && after.by == me());
    }

    // 會員到期日：到期日（含）之前才能排課、預約、確認；沒有設定到期日就不限制
    function memberEndOk(uid, date) {
      let path = /databases/$(database)/documents/users/$(uid);
      return !exists(path) || memberEndAllows(get(path).data, date);
    }
    function memberEndAllows(u, date) {
      return !('memberEnd' in u) || !(u.memberEnd is string) || u.memberEnd == '' || date <= u.memberEnd;
    }
    function sessionStudentOk(d) {
      return d.get('studentUid', '') == '' || memberEndOk(d.studentUid, d.date);
    }

    match /sessions/{sessionId} {
      // 學員只能讀自己的課與開放預約的時段（看不到別的學員的課、教練寫的課堂摘要）
      allow read:   if isCoachOrAdmin()
                    || (signedIn() && (resource.data.studentUid == me() || resource.data.status == 'open'));
      allow create: if isCoach() && request.resource.data.coachId == me()
                    && sessionStudentOk(request.resource.data)
                    && request.resource.data.status in ['open', 'pending']
                    && !('checkIn' in request.resource.data) && !('checkOut' in request.resource.data);
      // 已簽到的課是交付證據，只有管理員能刪
      allow delete: if isAdmin() || (isCoach() && resource.data.coachId == me() && !('checkIn' in resource.data));
      allow update: if isAdmin()
                    || (isCoach() && resource.data.coachId == me()
                        && stampOk('checkIn') && stampOk('checkOut')
                        // 改了日期或學員 → 必須在學員會員到期日之內
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['date', 'studentUid'])
                            || sessionStudentOk(request.resource.data))
                        // 簽退前一定要先簽到
                        && (request.resource.data.get('checkOut', null) == null || request.resource.data.get('checkIn', null) != null))
                    // 學員：上課時自己簽到（只能寫 checkIn，且身分標記為 student）
                    || (signedIn() && resource.data.studentUid == me()
                        && resource.data.status == 'confirmed'
                        && onlyChanges(['checkIn', 'updatedAt'])
                        && stampOk('checkIn')
                        && request.resource.data.checkIn.role == 'student')
                    // 學員：確認或請求改期自己的課
                    || (signedIn() && resource.data.studentUid == me()
                        && request.resource.data.status in ['confirmed', 'reschedule']
                        && (request.resource.data.status == 'reschedule' || memberEndOk(me(), resource.data.date))
                        && onlyChanges(['status', 'studentNote', 'confirmedAt', 'updatedAt']))
                    // 學員：預約開放時段（只能預約給自己，且只能從 open → confirmed）
                    || (signedIn() && resource.data.status == 'open'
                        && request.resource.data.status == 'confirmed'
                        && request.resource.data.studentUid == me()
                        && memberEndOk(me(), resource.data.date)
                        && onlyChanges(['status', 'studentUid', 'studentName', 'confirmedAt', 'updatedAt']));

      // 上課證明照片：該堂課的教練、學員、管理員可看；教練在簽退前可新增／刪除
      match /photos/{photoId} {
        function sess() { return get(/databases/$(database)/documents/sessions/$(sessionId)).data; }
        allow read:   if isAdmin() || (signedIn() && (sess().coachId == me() || sess().get('studentUid', '') == me()));
        allow create: if request.resource.data.addedByUid == me()
                      && request.resource.data.data is string && request.resource.data.data.size() < 1000000
                      && (isAdmin() || (isCoach() && sess().coachId == me() && !('checkOut' in sess())));
        allow delete: if isAdmin() || (isCoach() && sess().coachId == me() && !('checkOut' in sess()));
      }
    }

    // ── 成長路徑：學員只能寫自己的「回報」，確認與升階只有教練／管理員能做 ──
    match /journeys/{studentUid} {
      allow read:   if signedIn() && (me() == studentUid || isCoachOrAdmin());
      allow create, delete: if isCoachOrAdmin();
      allow update: if isCoachOrAdmin()
                    || (signedIn() && me() == studentUid && onlyChanges(['claims', 'updatedAt']));
    }

    // ── 財務：收款、教練分潤、支出、設定（應收學費／分潤費率）只有管理員能看與修改 ──
    match /payments/{id} { allow read, write: if isAdmin(); }
    match /payouts/{id}  { allow read, write: if isAdmin(); }
    match /expenses/{id} { allow read, write: if isAdmin(); }
    match /finance/{id}  { allow read, write: if isAdmin(); }

    // ── 財務異動紀錄：只能新增（必須是本人、伺服器時間），任何人都不能修改或刪除 ──
    match /financeLogs/{id} {
      allow read:   if isAdmin();
      allow create: if isAdmin() && request.resource.data.byUid == me() && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── 推播裝置：每人只能登記／移除自己的裝置；App 端無法讀取（只有伺服器發通知時讀）──
    match /pushTokens/{token} {
      allow create, update: if signedIn() && request.resource.data.uid == me() && request.resource.data.token == token;
      allow delete: if signedIn() && resource.data.uid == me();
      allow read: if false;
    }

    // ── 管理操作紀錄（重設密碼、刪除登入帳號）：由伺服器寫入，管理員只能讀 ──
    match /adminLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── 開通申請：有登入帳號但還沒有成員資料的人，只能替自己送出申請 ──
    match /accessRequests/{uid} {
      allow read:   if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.email == request.auth.token.email.lower()
                            && request.resource.data.name is string && request.resource.data.name.size() <= 50;
      allow delete: if isAdmin();
    }

    // ── 學員反饋 ──
    match /feedbacks/{feedbackId} {
      allow read:   if isCoachOrAdmin() || (signedIn() && resource.data.studentUid == me());
      allow create: if signedIn() && request.resource.data.studentUid == me();
      allow delete: if isAdmin();
    }
  }
}
